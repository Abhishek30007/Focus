# ==============================================================================
# FocusFlow Full-Stack Environment Template
# Copy this file to `/backend/.env` and update the secrets before running
# ==============================================================================

# Express Server Configuration
PORT=5000
NODE_ENV=production

# Database URI (MongoDB Local or MongoDB Atlas cloud connection)
MONGO_URI=mongodb://127.0.0.1:27017/focusflow

# Hashing and Session secrets
JWT_SECRET=use_a_strong_cryptographic_secret_here_e.g._openssl_rand_base64_32
SESSION_SECRET=use_another_strong_cryptographic_secret_here

# Frontend Client URL (For CORS setup in backend)
CLIENT_URL=http://localhost:5173

# FocusFlow AI Assistant Module
# AI_PROVIDER: 'gemini' (calls Gemini 1.5 API) | 'mock' (rule-based offline training mock)
AI_PROVIDER=mock
AI_API_KEY=your_google_gemini_api_key_here
