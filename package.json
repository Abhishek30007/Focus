{
  "name": "focusflow",
  "version": "1.0.0",
  "description": "FocusFlow AI meditation and productivity app concept recreation",
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm install && npm run install:backend && npm run install:frontend",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "test": "playwright test",
    "test:chromium": "playwright test --project=\"Desktop Chrome\"",
    "test:coverage": "playwright test --project=\"Desktop Chrome\" && nyc report --reporter=text --reporter=html",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.1",
    "nyc": "^17.1.0"
  }
}
